NODE_ENV=development

# API
API_PORT=3001
CORS_ORIGIN=http://localhost:3000,http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:3001/api
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PASSWORD_HASH_PEPPER=

# PostgreSQL
POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_USER=turalk
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_DB=turalk
POSTGRES_PORT=5432
DATABASE_URL=postgresql://turalk:change-me-for-local-development@localhost:5432/turalk?schema=public

# Redis
REDIS_IMAGE=redis:8.2-alpine
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# OpenSearch
OPENSEARCH_IMAGE=opensearchproject/opensearch:3.7.0
OPENSEARCH_PORT=9200
OPENSEARCH_DASHBOARDS_PORT=5601
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
